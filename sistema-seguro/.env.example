# Copiado para .env pelo `npm run setup`, que também preenche JWT_SECRET e CRYPTO_KEY
# com crypto.randomBytes(32).toString('hex'). NUNCA publique o .env de verdade.
# A senha 'senai' do Postgres é SOMENTE do laboratório local.
DATABASE_URL="postgresql://postgres:senai@127.0.0.1:5432/login_seguro?schema=public"
PORT=3002
JWT_SECRET=""
CRYPTO_KEY=""
RATE_LIMIT_JANELA_MIN=15
