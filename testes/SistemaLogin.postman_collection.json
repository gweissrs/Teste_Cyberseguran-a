              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logou', () => pm.response.to.have.status(200));",
                  "pm.test('veio cookie httpOnly', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.match(/HttpOnly/i));"
