        {
          "name": "T7b Força bruta — repita várias vezes (Runner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alvo@teste.com\",\n  \"senha\": \"chute\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Use o Collection Runner com 10 iterações. Nunca vem 429."
          }
        },
        {
          "name": "T8 CORS — preflight de origem maliciosa",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://site-malicioso.local"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Veja o header Access-Control-Allow-Origin na resposta."
          }
        }
      ]
    },
    {
