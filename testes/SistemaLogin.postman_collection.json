{
  "info": {
    "name": "Laboratório — Sistema de Login (Vulnerável x Seguro)",
    "description": "Requisições de ataque contra http://127.0.0.1:3001 (INTENCIONALMENTE INSEGURO — NÃO PUBLICAR) e http://127.0.0.1:3002 (seguro). Ajuste idAdmin/idBruno nas variáveis da coleção se os ids do seu banco forem outros (veja no pgAdmin). Use só nestes sistemas locais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "vuln",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "seguro",
      "value": "http://127.0.0.1:3002"
    },
    {
      "key": "idAdmin",
      "value": "3"
    },
    {
      "key": "idBruno",
      "value": "2"
    },
    {
      "key": "tokenVuln",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sistema Vulnerável (3001)",
      "item": [
        {
          "name": "00 Login normal (ana) — guarda o 'token'",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('tokenVuln', j.token);",
                  "pm.test('logou', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@teste.com\",\n  \"senha\": \"Ana@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Repare: o 'token' é só o id do usuário."
          }
        },
        {
          "name": "T1 SQL Injection — entra como admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@teste.com' --\",\n  \"senha\": \"qualquer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "O -- comenta a checagem de senha. Esperado no vulnerável: 200 com role admin."
          }
        },
        {
          "name": "T1b SQL Injection — payload alternativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"' OR '1'='1' --\",\n  \"senha\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "T1c Erro do banco vazando (aspa solta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"'\",\n  \"senha\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{vuln}}/api/auth/login",
              "host": [
                "{{vuln}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Mostra a mensagem do Postgres, o SQL e o stack trace."
          }
        },
        {
          "name": "T4 Token falsificado — Bearer <id do admin>",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idAdmin}}"
